# Database (Postgres via Prisma).
# On Vercel: Project -> Storage tab -> Connect Database -> choose "Prisma"
# (Prisma Postgres) from the Marketplace. That automatically sets
# DATABASE_URL for you — no manual value needed there.
# For local development, paste the same value here (Vercel CLI: `vercel env pull`).
DATABASE_URL="postgresql://user:password@localhost:5432/madar_mardom?schema=public"

# Session signing secret — required. Generate one with:
#   openssl rand -base64 32
# Any change to this value invalidates all existing logins.
AUTH_SECRET=""

# Initial admin account, created by `npx prisma db seed` (see README).
# There is no admin sign-up page by design — this is the only way to create one.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_NAME="مدیر سایت"
ADMIN_EMAIL=""

# Public site URL (used for canonical links, OpenGraph, sitemap, RSS)
NEXT_PUBLIC_SITE_URL="https://madarmardom.ir"

# AI provider (for src/lib/ai.ts once stubs are replaced with real calls)
ANTHROPIC_API_KEY=""

# File uploads (Vercel Blob — Storage tab on your Vercel project auto-injects this
# once you create a Blob store and connect it; no manual value needed there)
BLOB_READ_WRITE_TOKEN=""

# Captcha (Cloudflare Turnstile — protects the anonymous "صدای مردم" submission form).
# Get free keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Must be prefixed NEXT_PUBLIC_ so the site key reaches the browser widget;
# the secret key must NOT have that prefix — it's used only in the API route.
# For local development, Cloudflare's official always-pass test keys work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Social channel links (footer + article share buttons — src/lib/social-links.ts).
# Telegram, Eitaa, Bale, and Instagram already have real defaults baked into
# the code, so these are only needed if you want to override one without a
# code change. Aparat, WhatsApp, and YouTube have no default — set these to
# make them appear.
# NEXT_PUBLIC_TELEGRAM_URL=""
# NEXT_PUBLIC_EITAA_URL=""
# NEXT_PUBLIC_BALE_URL=""
# NEXT_PUBLIC_INSTAGRAM_URL=""
# NEXT_PUBLIC_APARAT_URL=""
# NEXT_PUBLIC_WHATSAPP_URL=""
# NEXT_PUBLIC_YOUTUBE_URL=""
