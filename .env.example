# Database (Postgres via Prisma).
# On Vercel: Project -> Storage tab -> Connect Database -> choose "Prisma"
# (Prisma Postgres) from the Marketplace. That automatically sets
# DATABASE_URL for you — no manual value needed there.
# For local development, paste the same value here (Vercel CLI: `vercel env pull`).
DATABASE_URL="postgresql://user:password@localhost:5432/madar_mardom?schema=public"

# Session signing secret — required. Generate one with:
#   openssl rand -base64 32
# Any change to this value invalidates all existing logins.
AUTH_SECRET=""

# Initial admin account, created by `npx prisma db seed` (see README).
# There is no admin sign-up page by design — this is the only way to create one.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_NAME="مدیر سایت"
ADMIN_EMAIL=""

# Public site URL (used for canonical links, OpenGraph, sitemap, RSS)
NEXT_PUBLIC_SITE_URL="https://madaremardom.ir"

# AI provider (for src/lib/ai.ts once stubs are replaced with real calls)
ANTHROPIC_API_KEY=""

# File uploads (Vercel Blob — Storage tab on your Vercel project auto-injects this
# once you create a Blob store and connect it; no manual value needed there)
BLOB_READ_WRITE_TOKEN=""

# Captcha (for the Voice of People submission form)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
